---
import Layout from "@/layouts/Layout.astro";
import Topbar from "@/components/Topbar.astro";
import { createClient } from "@/lib/supabase";
import type { Recipe } from "@/types";
import { CATEGORY_LABELS_PL } from "@/types";

const supabase = createClient(Astro.request.headers, Astro.cookies);

let recipes: Pick<Recipe, "id" | "name" | "category">[] = [];

if (supabase) {
  const { data } = await supabase.from("recipes").select("id, name, category").order("name", { ascending: true });
  if (data) {
    recipes = data;
  }
}
---

<Layout title="Przepisy">
  <div class="bg-cosmic relative min-h-screen">
    <div class="relative z-10 p-4 sm:p-8">
      <Topbar />
      <main class="mx-auto max-w-2xl px-4 py-12">
        <h1 class="mb-8 text-2xl font-bold text-white">Twoje przepisy</h1>
        {
          recipes.length === 0 ? (
            <div class="rounded-xl border border-white/10 bg-white/5 p-8 text-center backdrop-blur-xl">
              <p class="mb-6 text-blue-100/70">
                Nie masz jeszcze żadnych przepisów. Dodaj pierwszy, aby zacząć układać harmonogramy obiadów.
              </p>
              <button
                disabled
                title="wkrótce"
                class="inline-flex cursor-not-allowed items-center justify-center rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white opacity-50"
              >
                Dodaj przepis
              </button>
              <p class="mt-3 text-xs text-blue-100/50">wkrótce</p>
            </div>
          ) : (
            <ul class="space-y-2">
              {recipes.map((recipe) => (
                <li class="flex items-center justify-between rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white backdrop-blur-sm">
                  <span class="font-medium">{recipe.name}</span>
                  <span class="text-sm text-blue-100/60">{CATEGORY_LABELS_PL[recipe.category]}</span>
                </li>
              ))}
            </ul>
          )
        }
      </main>
    </div>
  </div>
</Layout>
